{
  "name": "intelbras-tv-viewer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "dev:all": "node --env-file-if-exists=.env scripts/dev.mjs",
    "start": "node --env-file-if-exists=.env scripts/dev.mjs",
    "serve": "pnpm build && node --env-file-if-exists=.env scripts/serve.mjs",
    "serve:static": "node --env-file-if-exists=.env scripts/serve.mjs",
    "api": "node --env-file-if-exists=.env --experimental-strip-types server/index.ts",
    "dev:api": "pnpm api",
    "build": "tsc -b && vite build",
    "format": "oxfmt . README.md compose.yaml",
    "format:check": "oxfmt --check . README.md compose.yaml",
    "lint": "oxlint --react-plugin --import-plugin .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "quality:check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "check": "pnpm quality:check",
    "preview": "vite preview",
    "relay:config": "node --env-file-if-exists=.env scripts/generate-mediamtx-config.mjs",
    "relay:up": "docker compose up -d --build mediamtx",
    "relay:logs": "docker compose logs -f mediamtx",
    "relay:down": "docker compose down",
    "docker:build": "node --env-file-if-exists=.env scripts/containers-build.mjs",
    "docker:up": "node --env-file-if-exists=.env scripts/containers-up.mjs",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f --tail=100 app mediamtx",
    "docker:status": "docker compose ps"
  },
  "dependencies": {
    "@grafana/faro-web-sdk": "^2.10.0",
    "@grafana/faro-web-tracing": "^2.10.0",
    "@hono/node-server": "^2.1.1",
    "abortcontroller-polyfill": "^1.7.8",
    "hls.js": "^1.7.0",
    "hono": "^4.13.3",
    "i18next": "^26.3.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "whatwg-fetch": "^3.6.20"
  },
  "devDependencies": {
    "@grafana/faro-rollup-plugin": "^0.11.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-legacy": "8.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "30.0.1",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "terser": "^5.50.0",
    "typescript": "7.0.2",
    "vite": "^8.2.0",
    "vitest": "4.1.11"
  }
}
