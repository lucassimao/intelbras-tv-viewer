{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "proseWrap": "preserve",
  "ignorePatterns": [
    "**/node_modules/**",
    "dist/**",
    "runtime/**",
    "artifacts/**",
    ".agent-browser/**",
    "**/*.sqlite",
    "**/*.sqlite-*",
    "runtime/mediamtx.yml"
  ],
  "overrides": [
    {
      "files": ["**/*.md"],
      "options": {
        "proseWrap": "preserve"
      }
    },
    {
      "files": ["**/*.yaml", "**/*.yml"],
      "options": {
        "singleQuote": false
      }
    }
  ]
}
