# Local runtime configuration. Copy this file to .env and replace the
# placeholder. .env is ignored by Git and must remain readable only by you.
CAMERA_PASSWORD=replace-with-local-camera-password

# Optional, non-secret overrides.
CAMERA_USERNAME=admin
# VITE_HLS_ORIGIN=http://192.168.0.119:8888

# Optional Grafana Cloud Frontend Observability (Faro). Leave VITE_FARO_URL
# unset to disable all Faro imports and requests. These values are public in
# the browser bundle; never use an administrative Grafana token here.
# VITE_FARO_URL=https://faro-collector.example.invalid/collect
# VITE_FARO_APP_KEY=public-app-key
# VITE_FARO_APP_NAME=intelbras-tv-viewer
# VITE_FARO_ENVIRONMENT=local
# VITE_APP_VERSION=dev
